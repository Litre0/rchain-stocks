# Raw pipeline state. pools.json alone is 20 MB and goes stale within minutes,
# so it is rebuilt locally rather than committed. dashboard.html IS committed --
# it has the snapshot inlined, so a fresh clone opens with data already in it.
data/pools.json
data/tokens.json
data/snapshot.json
data/live.json
data/live_1h.json
data/stocks.json
__pycache__/
*.pyc

# real identifiers for leakcheck.sh — never committed
.leakpatterns

# one-time local remediation tool; its comments name the very identifiers
# leakcheck exists to catch, so it is never published
fix-identity.sh
